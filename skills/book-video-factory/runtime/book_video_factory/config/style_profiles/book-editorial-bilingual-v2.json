    }
  },
  "asset_ready_approvals": [],
  "required_publish_approvals": [
    "script",
    "cover_rights",
    "bgm_rights",
    "sfx_rights",
    "voice_rights",
    "english_native",
    "publish"
  ],
  "conditional_publish_approvals": {},
  "prohibitions": [
    "generated_book_cover",
    "unlicensed_music_or_sfx",
    "unauthorized_voice_clone",
    "unreviewed_publish"
  ]
