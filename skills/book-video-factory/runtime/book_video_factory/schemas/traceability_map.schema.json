{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/book-video-factory/traceability_map.schema.json",
  "title": "Script-claim-scene traceability map",
  "type": "object",
  "required": [
    "schema_version",
    "traceability_id",
    "project_id",
    "release_id",
    "content_package_sha256",
    "script_path",
    "scene_manifest_path",
    "links"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "traceability_id": {"type": "string", "pattern": "^TRC-"},
    "project_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "content_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "script_path": {"type": "string", "minLength": 1},
    "scene_manifest_path": {"type": "string", "minLength": 1},
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["script_line_id", "evidence_mode", "claim_ids", "scene_ids"],
        "properties": {
          "script_line_id": {"type": "string", "pattern": "^V[0-9]{2}$"},
          "evidence_mode": {"enum": ["claim_backed", "editorial_no_claim"]},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "scene_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
          "editorial_note": {"type": "string"}
        }
      }
    },
    "attached_at": {"type": "string"},
    "source_map_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scene_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_summary": {"type": "object"}
  }
}
