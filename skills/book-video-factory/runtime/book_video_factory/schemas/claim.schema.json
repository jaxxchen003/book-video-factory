{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/book-video-factory/claim.schema.json",
  "title": "Materialized evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "origin",
    "claim_type",
    "text_zh",
    "text_en",
    "source_document_ids",
    "content_unit_ids",
    "quote_refs",
    "status",
    "risk_level"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^CLM:(OPI|CAS)-[A-Z0-9-]+:[a-z_]+$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_unit_id", "field"],
      "properties": {
        "content_unit_id": {"type": "string"},
        "field": {"enum": ["core_claim", "case_summary", "case_result"]}
      }
    },
    "claim_type": {"enum": ["fact", "interpretation", "quotation", "recommendation"]},
    "text_zh": {"type": "string", "minLength": 1},
    "text_en": {"type": "string"},
    "source_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "content_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "quote_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_document_id", "locator", "excerpt"],
        "properties": {
          "source_document_id": {"type": "string"},
          "locator": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string"}
        }
      }
    },
    "status": {"enum": ["draft", "reviewed", "approved", "rejected"]},
    "risk_level": {"enum": ["low", "medium", "high"]}
  }
}
