{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/schemas/style_profile.schema.json",
  "title": "Book video style profile",
  "type": "object",
  "required": [
    "schema_version",
    "style_id",
    "display_name",
    "release_profile_id",
    "execution_mode",
    "supported_workflow_modes",
    "output",
    "generation_lanes",
    "required_publish_approvals"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "style_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {
      "type": "object",
      "required": ["zh-CN", "en"],
      "properties": {
        "zh-CN": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "release_profile_id": {"type": "string", "minLength": 1},
    "execution_mode": {
      "enum": ["deterministic_local_renderer", "orchestration_and_import"]
    },
    "supported_workflow_modes": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["single-book", "content-system-backed"]},
      "uniqueItems": true
    },
    "generation_lane_required": {"type": "boolean"},
    "default_generation_lane": {"type": "string"},
    "generation_lanes": {"type": "object", "minProperties": 1},
    "required_publish_approvals": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
