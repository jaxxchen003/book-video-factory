{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/schemas/release_profile.schema.json",
  "title": "Book video release profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "renderer", "canvas", "script", "visual", "typography", "audio", "video"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_revision": {"type": "integer", "minimum": 1},
    "renderer": {"enum": ["build_batch_video_v3", "external_clip_timeline_v1"]},
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1},
        "aspect_ratio": {"type": "string"}
      }
    },
    "script": {
      "type": "object",
      "properties": {
        "language_mode": {"enum": ["zh", "bilingual", "zh_or_bilingual"]},
        "line_count": {"type": "integer", "minimum": 1},
        "line_count_policy": {"enum": ["variable"]}
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "scene_count": {"type": "integer", "minimum": 1},
        "scene_count_policy": {"enum": ["manifest"]},
        "scene_format": {"enum": ["png", "jpg", "jpeg", "mp4"]},
        "asset_manifest": {"type": "string", "minLength": 1}
      }
    },
    "typography": {"type": "object"},
    "audio": {"type": "object"},
    "video": {"type": "object"}
  },
  "additionalProperties": true
}
