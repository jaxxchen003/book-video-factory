{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book-video-factory.local/schemas/renderer-capabilities-v1.schema.json",
  "title": "Renderer Contract v1 Capability Document",
  "description": "Versioned renderer capability declaration used for pure preflight comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "renderer", "supported_contract_versions", "determinism", "constraints", "capabilities", "supported_extensions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "supported_contract_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {"const": "1.0"},
      "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "requires_seed", "notes"],
      "properties": {
        "level": {"enum": ["semantic", "bitwise", "best_effort"]},
        "requires_seed": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_width", "max_height", "max_fps", "portable_paths_required"],
      "properties": {
        "max_width": {"type": "integer", "minimum": 1},
        "max_height": {"type": "integer", "minimum": 1},
        "max_fps": {"type": "integer", "minimum": 1},
        "portable_paths_required": {"const": true}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["still_images", "layered_images", "video_clips", "captions", "word_highlight", "camera_motion", "vector_overlays", "audio_playback", "audio_mixing", "waveform", "transitions", "preview", "deterministic_render"],
      "properties": {
        "still_images": {"$ref": "#/$defs/capability"},
        "layered_images": {"$ref": "#/$defs/capability"},
        "video_clips": {"$ref": "#/$defs/capability"},
        "captions": {"$ref": "#/$defs/capability"},
        "word_highlight": {"$ref": "#/$defs/capability"},
        "camera_motion": {"$ref": "#/$defs/capability"},
        "vector_overlays": {"$ref": "#/$defs/capability"},
        "audio_playback": {"$ref": "#/$defs/capability"},
        "audio_mixing": {"$ref": "#/$defs/capability"},
        "waveform": {"$ref": "#/$defs/capability"},
        "transitions": {"$ref": "#/$defs/capability"},
        "preview": {"$ref": "#/$defs/capability"},
        "deterministic_render": {"$ref": "#/$defs/capability"}
      }
    },
    "supported_extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_versions"],
        "properties": {
          "schema_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "version", "constraints", "determinism"],
      "properties": {
        "supported": {"type": "boolean"},
        "version": {"type": "string", "minLength": 1},
        "constraints": {"type": "object", "additionalProperties": true},
        "determinism": {"enum": ["deterministic", "seeded", "best_effort"]}
      }
    }
  }
}
