{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/book-video-factory/content_system_package.schema.json",
  "title": "Immutable dbs-content-system bridge package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "source_system",
    "source_documents",
    "content_units",
    "claims",
    "assembly_brief"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "package_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,127}$"},
    "source_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "snapshot_id", "exported_at"],
      "properties": {
        "name": {"const": "dbs-content-system"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "exported_at": {"type": "string", "minLength": 1}
      }
    },
    "source_documents": {"type": "array", "minItems": 1, "items": {"$ref": "source_document.schema.json"}},
    "content_units": {"type": "array", "minItems": 1, "items": {"$ref": "content_unit.schema.json"}},
    "claims": {"type": "array", "items": {"$ref": "claim.schema.json"}},
    "assembly_brief": {"$ref": "assembly_brief.schema.json"}
  }
}
